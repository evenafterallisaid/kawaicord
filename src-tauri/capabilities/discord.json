{
  "identifier": "discord",
  "description": "Discord settings and desktop integration; no filesystem or shell access",
  "windows": [
    "main",
    "instance-*"
  ],
  "local": false,
  "remote": {
    "urls": [
      "https://discord.com/*",
      "https://ptb.discord.com/*",
      "https://canary.discord.com/*"
    ]
  },
  "permissions": [
    "allow-open-settings",
    "allow-reload-discord",
    "allow-restart-app",
    "allow-report-runtime",
    "allow-set-unread",
    "allow-notification-permission",
    "allow-notify",
    "allow-close-notification",
    "allow-window-action",
    "allow-open-link",
    "allow-restart-recovery",
    "allow-get-settings",
    "allow-save-config",
    "allow-refresh-mods",
    "allow-check-update",
    "allow-install-update",
    "allow-open-releases",
    "allow-list-instances",
    "allow-open-instance",
    "allow-close-instance",
    "allow-close-all-instances",
    "allow-clear-instance-session",
    "allow-report-instance-user",
    "allow-cloud-request"
  ]
}
