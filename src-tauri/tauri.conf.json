{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kawaicord",
  "version": "2.0.2",
  "identifier": "com.kawaicord.native",
  "build": {
    "frontendDist": "../web-dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Discord with Shelter, Vencord, Equicord or Illegalcord",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMzU0NkIzQkIzMDdEQjgKUldTNGZUQzdzMFkxZ0VKWFJkbmNxSnA3VDd2bVJFSERFS2EwOHJaZm9JWVdQbVcwK1NrQjB5VWoK",
      "requireSignedVersion": true
    }
  }
}
